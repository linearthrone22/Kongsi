# Salin ke .env.local untuk memakai Monad Testnet (default tanpa file ini: Hardhat lokal).
NEXT_PUBLIC_NETWORK=monadTestnet
NEXT_PUBLIC_RPC=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER=https://testnet.monadvision.com
NEXT_PUBLIC_SYMBOL=MON
NEXT_PUBLIC_CHAIN_NAME=Monad Testnet

# Upload file bukti ke IPFS (Pinata). Key baru: scope "Files: Write". JANGAN di-commit.
PINATA_JWT=
# Opsional: gateway khusus akun Pinata, mis. https://nama-anda.mypinata.cloud
PINATA_GATEWAY=
